<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/..\..\FrameXML\UI.xsd">
	<Script file="Plater_Script_Include.lua" />

	<!-- Temucraft: 3.3.5 XML has no mixin, parentArray, ignoreParentScale or useParentLevel: OnLoad does the mixin and the Textures list -->
	<Frame name="PlaterNamePlateFullBorderTemplate" setAllPoints="true" virtual="true">
		<Layers>
			<Layer level="BACKGROUND">
				<!-- Left -->
				<Texture parentKey="Left">
					<Size x="1.0" />
					<Anchors>
						<Anchor point="TOPRIGHT" relativePoint="TOPLEFT" x="0" y="1.0" />
						<Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMLEFT" x="0" y="-1.0" />
					</Anchors>
					<Color r="1" g="1" b="1" a="1"/>
				</Texture>

				<!-- Right -->
				<Texture parentKey="Right">
					<Size x="1.0" />
					<Anchors>
						<Anchor point="TOPLEFT" relativePoint="TOPRIGHT" x="0" y="1.0" />
						<Anchor point="BOTTOMLEFT" relativePoint="BOTTOMRIGHT" x="0" y="-1.0" />
					</Anchors>
					<Color r="1" g="1" b="1" a="1"/>
				</Texture>

				<!-- Bottom -->
				<Texture parentKey="Bottom">
					<Size y="1.0" />
					<Anchors>
						<Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" />
						<Anchor point="TOPRIGHT" relativePoint="BOTTOMRIGHT" />
					</Anchors>
					<Color r="1" g="1" b="1" a="1"/>
				</Texture>

				<!-- Top -->
				<Texture parentKey="Top">
					<Size y="1.0" />
					<Anchors>
						<Anchor point="BOTTOMLEFT" relativePoint="TOPLEFT" />
                        <Anchor point="BOTTOMRIGHT" relativePoint="TOPRIGHT" />
					</Anchors>
					<Color r="1" g="1" b="1" a="1"/>
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad>
				Mixin(self, PlaterNamePlateBorderTemplateMixin)
				self.Textures = { self.Left, self.Right, self.Bottom, self.Top }
				if self:GetParent() then self:SetFrameLevel(self:GetParent():GetFrameLevel()) end
			</OnLoad>
		</Scripts>
	</Frame>
</Ui>